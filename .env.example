# ---------------------------------------------------------------------------
# Grandmaster environment
# ---------------------------------------------------------------------------
# The app runs with ZERO config out of the box using a local, in-browser store
# (data persists in your browser and syncs live across tabs).
#
# To get real cross-device realtime, create a free Supabase project
# (https://supabase.com), run supabase/schema.sql in its SQL editor, and paste
# the two values below. Copy this file to `.env.local` and fill them in.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
